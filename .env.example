# ===========================================================================
# ZCard 环境配置
# 复制本文件为 .env 并按实际环境填写。带 = 空值的为必填,有默认值的可不改。
# ===========================================================================

# ---------- 应用基础 ----------
APP_NAME=ZCard                      # 站点名称,显示在标题/邮件等处
APP_ENV=local                       # 运行环境: local(本地) / production(生产) / testing(测试)
APP_KEY=                            # 应用密钥(必填)。留空时用 `php artisan key:generate` 生成,用于加密
APP_DEBUG=true                      # 调试模式: true 显示详细错误(仅本地!); production 必须 false
APP_URL=http://localhost:8092       # 站点访问地址(含端口),用于生成链接/回调地址

# ---------- 语言 ----------
APP_LOCALE=zh_CN                    # 默认界面语言: zh_CN(简体中文) / en(英文)
APP_FALLBACK_LOCALE=zh_CN           # 翻译缺失时的回退语言
APP_FAKER_LOCALE=zh_CN              # 测试数据(faker)的语言

# ---------- 维护模式 ----------
APP_MAINTENANCE_DRIVER=file         # 维护模式状态存储驱动: file(单机) / database(多机共享)
# APP_MAINTENANCE_STORE=database    # 当 DRIVER=database 时用哪个缓存存储

# ---------- Sail 端口(本地开发用) ----------
# Sail 宿主机暴露端口(按本机空闲端口调整,容器内仍走标准端口)
APP_PORT=8092                       # 本地访问端口
VITE_PORT=5174                      # 前端开发服务器端口
FORWARD_DB_PORT=3307                # MySQL 映射到宿主机的端口
FORWARD_REDIS_PORT=6380             # Redis 映射到宿主机的端口

# PHP_CLI_SERVER_WORKERS=4          # PHP 内置服务器工作进程数(本地用)

# ---------- 安全 ----------
BCRYPT_ROUNDS=12                    # 密码哈希强度(4-12,值越大越慢越安全;生产建议 12)

# ---------- 日志 ----------
LOG_CHANNEL=stack                   # 日志通道: stack(组合) / single(单文件) / daily(按天)
LOG_STACK=single                    # stack 组合的具体通道
LOG_DEPRECATIONS_CHANNEL=null       # 弃用警告日志通道(null=不单独记录)
LOG_LEVEL=debug                     # 日志级别: debug/info/warning/error(生产建议 error)

# ---------- 数据库 ----------
DB_CONNECTION=mysql                 # 数据库类型: mysql / sqlite / pgsql
DB_HOST=mysql                       # 数据库主机(Sail 容器内用 mysql; 本地直连用 127.0.0.1)
DB_PORT=3306                        # 数据库端口
DB_DATABASE=laravel                 # 数据库名
DB_USERNAME=sail                    # 数据库用户名
DB_PASSWORD=password                # 数据库密码

# ---------- Session ----------
SESSION_DRIVER=database             # Session 存储驱动: database(推荐) / file / redis
SESSION_LIFETIME=120                # Session 有效期(分钟)
SESSION_ENCRYPT=false               # 是否加密 Session 数据
SESSION_PATH=/                      # Session Cookie 路径
SESSION_DOMAIN=null                 # Session Cookie 作用域(如 .example.com)

# ---------- 广播 / 文件 / 队列 ----------
BROADCAST_CONNECTION=log            # 广播驱动: log / redis / pusher
FILESYSTEM_DISK=local               # 默认文件系统磁盘: local / public / s3
QUEUE_CONNECTION=database           # 队列驱动: database(推荐) / redis / sync(同步,调试用)

# ---------- 缓存 ----------
CACHE_STORE=database                # 缓存驱动: database / redis / file / array(测试用)
# CACHE_PREFIX=                     # 缓存键前缀(多应用共享缓存时用)

# ---------- Memcached ----------
MEMCACHED_HOST=127.0.0.1            # Memcached 主机(不用可忽略)

# ---------- Redis ----------
REDIS_CLIENT=phpredis               # Redis 客户端: phpredis(需装扩展) / predis(纯 PHP)
REDIS_HOST=127.0.0.1                # Redis 主机(Sail 容器内用 redis; 本地用 127.0.0.1)
REDIS_PASSWORD=null                 # Redis 密码(null=无密码)
REDIS_PORT=6379                     # Redis 端口

# ---------- 邮件 ----------
MAIL_MAILER=log                     # 邮件驱动: log(只记日志不真发) / smtp / sendmail / ses
MAIL_SCHEME=null                    # 传输协议: tls / ssl / null
MAIL_HOST=127.0.0.1                 # SMTP 服务器地址
MAIL_PORT=2525                      # SMTP 端口
MAIL_USERNAME=null                  # SMTP 用户名
MAIL_PASSWORD=null                  # SMTP 密码
MAIL_FROM_ADDRESS="hello@example.com"  # 发件人地址
MAIL_FROM_NAME="${APP_NAME}"        # 发件人名称(引用上面的 APP_NAME)

# ---------- AWS S3(对象存储,不用可忽略) ----------
AWS_ACCESS_KEY_ID=                  # AWS 访问密钥
AWS_SECRET_ACCESS_KEY=              # AWS 秘密密钥
AWS_DEFAULT_REGION=us-east-1        # AWS 区域
AWS_BUCKET=                         # S3 桶名
AWS_USE_PATH_STYLE_ENDPOINT=false   # 是否用 path-style 端点(MinIO 等需 true)

# ---------- 前端构建 ----------
VITE_APP_NAME="${APP_NAME}"         # 前端读取的应用名(引用 APP_NAME)

# ===========================================================================
# ZCard 业务配置
# ===========================================================================

APP_ADMIN_EMAIL=admin@zcard.local   # 初始管理员邮箱(安装向导用)
SANCTUM_STATEFUL_DOMAINS=localhost:5174,localhost:8092  # SPA 前端域名(用 Cookie 认证时必填,逗号分隔)
SESSION_DOMAIN=localhost            # Session Cookie 域名(与访问域名一致)
CARD_ENCRYPTION_KEY=                # 卡密加密密钥(必填)。用 `php artisan tinker` 执行 `base64_encode(random_bytes(32))` 生成,带 base64: 前缀

# ---------- 发卡模式 ----------
ZCARD_CARD_DELIVERY_MODE=status     # 卡密发货方式: status(标记卡状态,推荐) / delete(发卡后删除卡记录)

# ---------- 功能开关(详见 config/zcard.php) ----------
# 三级分销: 需 =true 才生效,再在后台「分销设置」开启
ZCARD_DISTRIBUTION=false            # 三级分销总开关: true 开启 / false 关闭

# ---------- 货源对接(spec §8.5) ----------
# 总开关。关闭时所有货源对接功能(对接上游拿货 + 对外供货)均不生效。灰度上线建议先 false
ZCARD_SUPPLY=false                  # 货源对接总开关: true 开启 / false 关闭(默认关)
# 两个方向可独立开关(总开关 =true 时才生效)
ZCARD_SUPPLY_UPSTREAM=true          # 作为下游(拿货): true 允许对接外部上游拿货
ZCARD_SUPPLY_SUPPLIER=true          # 作为上游(供货): true 允许别人/自己对接本站拿货
# 防重放 nonce 存储后端
ZCARD_SUPPLY_NONCE_STORE=cache      # cache(默认,用上面 CACHE_STORE) / redis(需配置 REDIS_*) / database(用 supply_nonces 表)
ZCARD_SUPPLY_RATE_LIMIT=60          # 对外供货 API 限流: 每账号每分钟最大请求数
ZCARD_SUPPLY_TS_SKEW=300            # 签名时间窗口(秒): 请求 timestamp 与服务器时间差超过此值则拒绝(防重放)
