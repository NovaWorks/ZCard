# ===========================================================================
# ZCard 环境配置(仓库默认值,clone 后开箱即用)
# ===========================================================================
# 本文件随仓库提交,仅含安全默认值(无真实密钥/密码)。
# 首次部署流程:clone → composer install → 访问首页 → 自动跳转 /install
# 安装向导会自动写入数据库凭据并生成 APP_KEY / CARD_ENCRYPTION_KEY。
#
# 如需手动配置:复制本行为真实值,或参照 .env.example(含详细注释)。
# ===========================================================================

# ---------- 应用基础 ----------
APP_NAME=ZCard
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=

# ---------- 语言 ----------
APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=zh_CN
APP_FAKER_LOCALE=zh_CN

# ---------- 维护模式 ----------
APP_MAINTENANCE_DRIVER=file

# ---------- 安全 ----------
BCRYPT_ROUNDS=12

# ---------- 日志 ----------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ---------- 数据库(安装向导会自动填充) ----------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ---------- Session ----------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ---------- 广播 / 文件 / 队列 ----------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ---------- 缓存 ----------
CACHE_STORE=database

# ---------- Memcached ----------
MEMCACHED_HOST=127.0.0.1

# ---------- Redis ----------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------- 邮件 ----------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------- AWS S3 ----------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------- 前端构建 ----------
VITE_APP_NAME="${APP_NAME}"

# ===========================================================================
# ZCard 业务配置
# ===========================================================================

APP_ADMIN_EMAIL=admin@zcard.local
SANCTUM_STATEFUL_DOMAINS=
SESSION_DOMAIN=null
CARD_ENCRYPTION_KEY=

# ---------- 发卡模式 ----------
ZCARD_CARD_DELIVERY_MODE=status

# ---------- 功能开关 ----------
ZCARD_DISTRIBUTION=false

# ---------- 货源对接(兜底默认值,运行时以 sysadmin 设置页为准) ----------
ZCARD_SUPPLY=false
ZCARD_SUPPLY_UPSTREAM=true
ZCARD_SUPPLY_SUPPLIER=true
ZCARD_SUPPLY_NONCE_STORE=cache
ZCARD_SUPPLY_RATE_LIMIT=60
ZCARD_SUPPLY_TS_SKEW=300
